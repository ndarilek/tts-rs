{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "postCreateCommand": ".devcontainer/postCreate.sh",
    // The emulator needs KVM; x86_64 images won't boot without it. Note this makes the container
    // itself fail to start where /dev/kvm is absent.
    "runArgs": [
        "--device=/dev/kvm"
    ],
    "containerEnv": {
        "ANDROID_HOME": "/usr/local/android",
        // The only way `cargo apk` finds the NDK, and it wants an exact version directory.
        // Keep in step with `ndkVersion` in the android-sdk feature below.
        "ANDROID_NDK_ROOT": "/usr/local/android/ndk/28.2.13676358",
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "GALLIUM_DRIVER": "llvmpipe"
    },
    "remoteEnv": {
        "PATH": "${containerWorkspaceFolder}/.devcontainer/bin:${containerEnv:PATH}:/root/.local/bin"
    },
    "features": {
        "ghcr.io/devcontainers/features/rust:1": {
            "targets": "wasm32-unknown-unknown,aarch64-linux-android,x86_64-linux-android,x86_64-pc-windows-msvc"
        },
        "ghcr.io/devcontainers/features/java:1": {
            "version": 21
        },
        // build.rs needs `d8` from build-tools and `android.jar` from platforms. The NDK version
        // is the one ANDROID_NDK_ROOT above names; keep the two in step.
        "ghcr.io/CASL0/devcontainer-features/android-sdk:1": {
            "platformsVersion": "36",
            "buildToolsVersion": "36.0.0",
            "installNdk": true,
            "ndkVersion": "28.2.13676358"
        }
    }
}